# Replace these documentation placeholders with targets suitable for the
# local network before enabling the service.
PM_TARGETS=primary-a:203.0.113.10:443,primary-b:198.51.100.10:443,primary-c:192.0.2.10:443

PM_MODE=headless
PM_LOG_DIR=/var/log/ping-monitor
PM_STATE_DIR=/var/lib/ping-monitor

PM_AUTO_TRACE=1
PM_STARTUP_GRACE_S=30
PM_TRACE_TIMEOUT_S=25
PM_TRACE_MAX_HOPS=20

# off, audio, pc-speaker, or both
PM_SOUND_BACKEND=off
# Optional Linux evdev path. Leave unset for the standard platform path.
# PM_PC_SPEAKER_DEVICE=/dev/input/by-path/platform-pcspkr-event-spkr

PM_TIMEOUT_MS=1500
PM_REMINDER_S=30
